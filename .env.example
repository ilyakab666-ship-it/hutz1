# ===== Telegram =====
BOT_TOKEN=
# ID админов через запятую (получают сообщения об ошибках и сбоях панели)
ADMIN_IDS=
# HTTPS-адрес, по которому Happ достучится до этого сервиса (см. cloudflared)
# Схема https:// подставится сама, если её забыли
PUBLIC_URL=https://xxxx.trycloudflare.com

# ===== Панель H1Cloud =====
H1_API_URL=https://your-panel.example/api
# Запасной адрес (http: токен уходит открытым текстом, включайте только при необходимости)
# H1_API_FALLBACK=
H1_API_TOKEN=
# Лимит устройств на стороне панели. Оставьте 0: лимит устройств ведёт бот (по x-hwid)
H1_DEVICE_LIMIT=0
# Только если нужен точный выбор (иначе применяются настройки панели «Инбаунды для новых клиентов»):
# H1_INBOUND_IDS=1,2
# H1_CHANNELS=main,bs

# ===== Триал и устройства =====
TRIAL_HOURS=24
TRIAL_GB=3
DEFAULT_DEVICES=1
# Папка под БД создаётся автоматически (например /data/vpn.db — путь на постоянном томе хостинга)
DB_PATH=vpn.db

# ===== Витрина и ссылки (обязательны для проверки платёжным провайдером) =====
BRAND=HUTZ Vpn
TAGLINE=Безопасное и быстрое подключение
LOCATION=Европа
# Юзернейм чистого саппорт-бота (https://t.me/<username>)
SUPPORT_URL=https://t.me/your_support_bot
PRIVACY_URL=https://telegra.ph/POLITIKA-KONFIDENCIALNOSTI-08-12-99
TERMS_URL=https://telegra.ph/PUBLICHNAYA-OFERTA-08-12-15
# Ссылка на площадку, где продаются коды (кнопка «Купить код»)
# SHOP_URL=
# Цены заданы в core.py (PACKS, EXTRA_DEVICE_RUB)

# ===== Платная подписка (выдаётся по промокодам) =====
# Лимит трафика платной подписки, ГБ (в тексте тарифов показывается как есть)
PAID_TRAFFIC_GB=1000

# ===== Уведомления =====
# Платным — за сколько часов до конца напомнить; тесту (24 ч) — ближе к концу
NOTIFY_EXPIRY_HOURS=24
NOTIFY_TRIAL_HOURS=2
NOTIFY_TRAFFIC_PCT=80
